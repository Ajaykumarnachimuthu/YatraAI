# ==============================================================================
# Yatra AI — Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME="Yātrā AI — Intelligent Multimodal Transit"
API_V1_PREFIX=/api
DEBUG=true

# Server Binding
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL in production; SQLite WAL fallback for zero-setup local run)
DATABASE_URL=sqlite:///./yatra_ai.db
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/yatra_ai

# Caching & Task Broker (Redis with automated in-memory LRU fallback)
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET_KEY=yatra_ai_super_secret_jwt_key_production_grade_32_bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Whitelist (JSON-formatted list of origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:8000","http://localhost:8000"]

# Machine Learning Recommendation Engine
CHAMPION_MODEL_PATH=results/models/champion_gb_core.joblib
CONFIG_PATH=config/synthetic_generation.yaml
DECISION_THRESHOLD=0.30
RATE_LIMIT_PER_MINUTE=60

